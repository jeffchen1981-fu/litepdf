+/* LITEPDF_PATCH_HTDOC_OUTLINE_V1 - applied by litepdf's cmake/ImportMuPDF.cmake;
+ * see third_party/mupdf-patches/ in the litepdf source. One-pass outline
+ * resolve, litepdf issue #229.
+ *
+ * Resolving each outline entry with htdoc_resolve_link walks the box tree
+ * from the root once per entry, so a book with N titles costs O(N^2) after
+ * every layout. This collects the ids the outline points at, walks the tree
+ * once in the order of find_box_target (html-outline.c) until each of them
+ * has its first match, and resolves every entry from that. An entry whose
+ * first match is at y >= 0 gets exactly what the root walk returns for it;
+ * any other value, or a failure while building the index, falls back to
+ * htdoc_resolve_link, the original code. */
+
+const char litepdf_mupdf_patch_notice_v1[] = "Modified by litepdf on 2026-11-12: one-pass outline resolve (#229)";
+
+/* A copy of html-outline.c's static find_first_content. */
+static fz_html_flow *
+lp_find_first_content(fz_html_box *box)
+{
+	while (box)
+	{
+		if (box->type == BOX_FLOW)
+			return box->u.flow.head;
+		box = box->down;
+	}
+	return NULL;
+}
+
+/* The ids the outline points at, each with a slot for the address of its
+ * first match's y. */
+typedef struct
+{
+	fz_tree *wanted;	/* id -> its slot (float **) */
+	float **slots;
+	int count;	/* distinct wanted ids */
+	int found;	/* slots filled */
+} lp_index;
+
+static int
+lp_count_nodes(fz_outline *node)
+{
+	int n = 0;
+	for (; node; node = node->next)
+		n += 1 + lp_count_nodes(node->down);
+	return n;
+}
+
+/* Adds each entry's target id once: fz_tree_insert sends an equal key to
+ * the right, so it is looked up first. The root is updated in place after
+ * every insert; fz_tree_new_node throws before it links anything, so after
+ * a throw index->wanted is still the whole tree. */
 static void
-htdoc_update_outline(fz_context *ctx, fz_document *doc, fz_outline *node)
+lp_want_targets(fz_context *ctx, lp_index *index, fz_outline *node)
+{
+	for (; node; node = node->next)
+	{
+		const char *s = strchr(node->uri, '#');
+		if (s && s[1] != 0 && !fz_tree_lookup(ctx, index->wanted, s+1))
+		{
+			index->wanted = fz_tree_insert(ctx, index->wanted, s+1, &index->slots[index->count]);
+			index->count++;
+		}
+		lp_want_targets(ctx, index, node->down);
+	}
+}
+
+/* Records y as id's first match if the outline points at id and no match
+ * was recorded yet. Returns 1 once every wanted id has its match. */
+static int
+lp_record(fz_context *ctx, lp_index *index, const char *id, float *y)
+{
+	float **slot = fz_tree_lookup(ctx, index->wanted, id);
+	if (slot && !*slot)
+	{
+		*slot = y;
+		index->found++;
+	}
+	return index->found == index->count;
+}
+
+/* The walk of find_box_target: a box's own id first, then a flow box's
+ * flows in order, otherwise the box's children; then the next box. Stops,
+ * returning 1, once every wanted id has its first match. */
+static int
+lp_index_boxes(fz_context *ctx, lp_index *index, fz_html_box *box)
+{
+	while (box)
+	{
+		if (box->id)
+		{
+			fz_html_flow *flow = lp_find_first_content(box);
+			if (lp_record(ctx, index, box->id, flow ? &flow->y : &box->s.layout.y))
+				return 1;
+		}
+		if (box->type == BOX_FLOW)
+		{
+			fz_html_flow *flow;
+			for (flow = box->u.flow.head; flow; flow = flow->next)
+				if (flow->box->id && lp_record(ctx, index, flow->box->id, &flow->y))
+					return 1;
+		}
+		else if (lp_index_boxes(ctx, index, box->down))
+			return 1;
+		box = box->next;
+	}
+	return 0;
+}
+
+static void
+lp_update_outline_from_index(fz_context *ctx, fz_document *doc_, lp_index *index, fz_outline *node)
+{
+	html_document *doc = (html_document*)doc_;
+	while (node)
+	{
+		fz_link_dest dest = fz_make_link_dest_none();
+		const char *s = strchr(node->uri, '#');
+		if (s && s[1] != 0)
+		{
+			float **slot = fz_tree_lookup(ctx, index->wanted, s+1);
+			float *yp = slot ? *slot : NULL;
+			if (yp)
+			{
+				float y = *yp;
+				if (y >= 0)
+				{
+					int page = y / doc->html->page_h;
+					dest = fz_make_link_dest_xyz(0, page, 0, y - page * doc->html->page_h, 0);
+				}
+				else
+				{
+					/* Negative or NaN: the root walk may go on to a
+					 * later match, so ask it. */
+					dest = htdoc_resolve_link(ctx, doc_, node->uri);
+				}
+			}
+		}
+		node->page = dest.loc;
+		node->x = dest.x;
+		node->y = dest.y;
+		lp_update_outline_from_index(ctx, doc_, index, node->down);
+		node = node->next;
+	}
+}
+
+/* The original update, used when the index could not be built. */
+static void
+lp_update_outline_root_walk(fz_context *ctx, fz_document *doc, fz_outline *node)
 {
 	while (node)
 	{
@@ -91,11 +236,51 @@ htdoc_update_outline(fz_context *ctx, fz_document *doc, fz_outline *node)
 		node->page = dest.loc;
 		node->x = dest.x;
 		node->y = dest.y;
-		htdoc_update_outline(ctx, doc, node->down);
+		lp_update_outline_root_walk(ctx, doc, node->down);
