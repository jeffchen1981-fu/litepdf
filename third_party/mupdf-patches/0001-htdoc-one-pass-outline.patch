 	{
@@ -91,11 +190,39 @@ htdoc_update_outline(fz_context *ctx, fz_document *doc, fz_outline *node)
 		node->page = dest.loc;
 		node->x = dest.x;
 		node->y = dest.y;
-		htdoc_update_outline(ctx, doc, node->down);
+		lp_update_outline_root_walk(ctx, doc, node->down);
