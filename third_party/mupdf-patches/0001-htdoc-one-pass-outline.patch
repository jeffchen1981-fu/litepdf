 }
 
+static void
+htdoc_update_outline(fz_context *ctx, fz_document *doc, fz_outline *node)
+{
+	lp_index index = { NULL, NULL, 0, 0 };
+	int built = 0;
+
+	if (!node)
+		return;
+
+	fz_var(index);
+	fz_var(built);
+	fz_try(ctx)
+	{
+		/* At most one slot per entry; the slots exist before any key
+		 * points at them. */
+		index.slots = fz_calloc(ctx, lp_count_nodes(node), sizeof *index.slots);
+		lp_want_targets(ctx, &index, node);
+		built = 1;
+	}
+	fz_catch(ctx)
+	{
+		/* Today the update cannot fail, so it must not start failing the
+		 * page count: use the root walk (what was built is dropped below).
+		 * The error is reported, which also clears it from the context. */
+		fz_report_error(ctx);
+	}
+
+	if (built)
+	{
+		/* The walk allocates nothing. */
+		if (index.count > 0)
+			lp_index_boxes(ctx, &index, ((html_document*)doc)->html->tree.root);
+		lp_update_outline_from_index(ctx, doc, &index, node);
+	}
+	else
+		lp_update_outline_root_walk(ctx, doc, node);
+	fz_drop_tree(ctx, index.wanted, NULL);
+	fz_free(ctx, index.slots);
+}
+
